# Copiar a .env y ajustar
PORT=3000
# Carpeta donde la API guarda los archivos JSON (no hay base de datos, ver ADR-010)
SGT_DATA_DIR=./datos
# Secreto para firmar las sesiones. Generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SGT_JWT_SECRET=
# Usuario del primer coordinador (solo se usa si no hay usuarios). Si no se da contraseña, se genera una temporal y se muestra en consola.
SGT_ADMIN_DOCUMENTO=admin
SGT_ADMIN_PASSWORD=
