// Modelo de datos del SGT (plan técnico §9.5 + ADR-008 y ADR-009).
// Todas las fechas-hora se guardan en UTC (timestamptz) y se presentan en America/Bogota.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Rol {
  ENFERMERO
  COORDINADOR
}

enum Cargo {
  AUXILIAR
  PROFESIONAL
  JEFE
  ESPECIALISTA
}

enum EstadoCuadro {
  BORRADOR
  PUBLICADO
  CERRADO
}

enum EstadoAsignacion {
  ACTIVA
  LIBERADA
  REEMPLAZADA
}

enum TipoMarcacion {
  ENTRADA
  SALIDA
}

enum TipoSolicitud {
  INTERCAMBIO
  CESION
  PERMISO
  VACACIONES
}

enum EstadoSolicitud {
  BORRADOR
  PENDIENTE_COMPANERO
  RECHAZADA_COMPANERO
  PENDIENTE_COORDINADOR
  APROBADA
  RECHAZADA
  CANCELADA
  APLICADA
}

enum CategoriaPermiso {
  PERSONAL
  CALAMIDAD
  CITA_MEDICA
  ACADEMICO
  OTRO
}

enum EstadoEgreso {
  CONTINUA_HOSPITALIZADO
  ALTA_MEJORADO
  REMITIDO
  ALTA_VOLUNTARIA
  FALLECIDO
  OTRO
}

enum TipoDocumento {
  CC
  TI
  RC
  CE
  PA
  PPT
}

enum TipoCanal {
  GENERAL
  DIRECTO
}

// ---------------------------------------------------------------------------
// Personal
// ---------------------------------------------------------------------------

model Usuario {
  id                  String    @id @default(uuid()) @db.Uuid
  documento           String    @unique
  nombres             String
  email               String?   @unique
  rol                 Rol       @default(ENFERMERO)
  cargo               Cargo
  fechaIngreso        DateTime  @map("fecha_ingreso") @db.Date
  activo              Boolean   @default(true)
  hashPassword        String    @map("hash_password")
  debeCambiarPassword Boolean   @default(true) @map("debe_cambiar_password")
  aceptoPrivacidadEn  DateTime? @map("acepto_privacidad_en") @db.Timestamptz
  creadoEn            DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  salarios              SalarioUsuario[]
  asignaciones          Asignacion[]
  marcaciones           Marcacion[]         @relation("MarcacionUsuario")
  marcacionesCorregidas Marcacion[]         @relation("MarcacionCorrector")
  solicitudes           Solicitud[]         @relation("SolicitudSolicitante")
  solicitudesCompanero  Solicitud[]         @relation("SolicitudCompanero")
  solicitudesResueltas  Solicitud[]         @relation("SolicitudResolutor")
  periodosVacaciones    PeriodoVacaciones[]
  pacientesAtendidos    PacienteAtendido[]
  mensajes              Mensaje[]
  versionesCuadro       CuadroVersion[]

  @@map("usuario")
}

/// Historial salarial con vigencia (RF-ADM-04). El valor hora usa el salario vigente en la fecha trabajada.
model SalarioUsuario {
  id           String    @id @default(uuid()) @db.Uuid
  usuarioId    String    @map("usuario_id") @db.Uuid
  salarioBase  Decimal   @map("salario_base") @db.Decimal(14, 2)
  vigenteDesde DateTime  @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, vigenteDesde])
  @@map("salario_usuario")
}

// ---------------------------------------------------------------------------
// Cuadro de turnos
// ---------------------------------------------------------------------------

model TipoTurno {
  id         String  @id @default(uuid()) @db.Uuid
  codigo     String  @unique
  nombre     String
  /// Hora local "HH:mm"
  horaInicio String  @map("hora_inicio")
  /// Hora local "HH:mm"; si es <= horaInicio termina al día siguiente
  horaFin    String  @map("hora_fin")
  color      String
  activo     Boolean @default(true)

  asignaciones Asignacion[]

  @@map("tipo_turno")
}

model Cuadro {
  id            String       @id @default(uuid()) @db.Uuid
  periodoInicio DateTime     @map("periodo_inicio") @db.Date
  periodoFin    DateTime     @map("periodo_fin") @db.Date
  estado        EstadoCuadro @default(BORRADOR)
  versionActual Int          @default(0) @map("version_actual")

  asignaciones Asignacion[]
  versiones    CuadroVersion[]

  @@unique([periodoInicio, periodoFin])
  @@map("cuadro")
}

model CuadroVersion {
  id       String   @id @default(uuid()) @db.Uuid
  cuadroId String   @map("cuadro_id") @db.Uuid
  numero   Int
  autorId  String   @map("autor_id") @db.Uuid
  motivo   String
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz

  cuadro Cuadro  @relation(fields: [cuadroId], references: [id])
  autor  Usuario @relation(fields: [autorId], references: [id])

  @@unique([cuadroId, numero])
  @@map("cuadro_version")
}

model Asignacion {
  id          String           @id @default(uuid()) @db.Uuid
  cuadroId    String           @map("cuadro_id") @db.Uuid
  usuarioId   String           @map("usuario_id") @db.Uuid
  tipoTurnoId String           @map("tipo_turno_id") @db.Uuid
  inicio      DateTime         @db.Timestamptz
  fin         DateTime         @db.Timestamptz
  estado      EstadoAsignacion @default(ACTIVA)

  cuadro             Cuadro             @relation(fields: [cuadroId], references: [id])
  usuario            Usuario            @relation(fields: [usuarioId], references: [id])
  tipoTurno          TipoTurno          @relation(fields: [tipoTurnoId], references: [id])
  marcaciones        Marcacion[]
  pacientesAtendidos PacienteAtendido[]
  solicitudesOrigen  Solicitud[]        @relation("SolicitudOrigen")
  solicitudesDestino Solicitud[]        @relation("SolicitudDestino")

  @@index([usuarioId, inicio])
  @@map("asignacion")
}

// ---------------------------------------------------------------------------
// Asistencia
// ---------------------------------------------------------------------------

model Marcacion {
  id               String        @id @default(uuid()) @db.Uuid
  usuarioId        String        @map("usuario_id") @db.Uuid
  asignacionId     String?       @map("asignacion_id") @db.Uuid
  tipo             TipoMarcacion
  /// Siempre la hora del servidor (ADR-005)
  horaServidor     DateTime      @map("hora_servidor") @db.Timestamptz
  equipoOrigen     String?       @map("equipo_origen")
  corregida        Boolean       @default(false)
  motivoCorreccion String?       @map("motivo_correccion")
  corregidaPorId   String?       @map("corregida_por") @db.Uuid

  usuario      Usuario     @relation("MarcacionUsuario", fields: [usuarioId], references: [id])
  asignacion   Asignacion? @relation(fields: [asignacionId], references: [id])
  corregidaPor Usuario?    @relation("MarcacionCorrector", fields: [corregidaPorId], references: [id])

  @@index([usuarioId, horaServidor])
  @@map("marcacion")
}

// ---------------------------------------------------------------------------
// Solicitudes y vacaciones
// ---------------------------------------------------------------------------

model Solicitud {
  id                   String            @id @default(uuid()) @db.Uuid
  tipo                 TipoSolicitud
  estado               EstadoSolicitud   @default(BORRADOR)
  solicitanteId        String            @map("solicitante_id") @db.Uuid
  companeroId          String?           @map("companero_id") @db.Uuid
  asignacionOrigenId   String?           @map("asignacion_origen_id") @db.Uuid
  asignacionDestinoId  String?           @map("asignacion_destino_id") @db.Uuid
  fechaDesde           DateTime?         @map("fecha_desde") @db.Date
  fechaHasta           DateTime?         @map("fecha_hasta") @db.Date
  categoriaMotivo      CategoriaPermiso? @map("categoria_motivo")
  comentario           String?
  /// RF-SOL-08: solicitudes del coordinador sobre sí mismo
  autoaprobada         Boolean           @default(false)
  resueltaPorId        String?           @map("resuelta_por") @db.Uuid
  resueltaEn           DateTime?         @map("resuelta_en") @db.Timestamptz
  comentarioResolucion String?           @map("comentario_resolucion")
  creadaEn             DateTime          @default(now()) @map("creada_en") @db.Timestamptz

  solicitante       Usuario     @relation("SolicitudSolicitante", fields: [solicitanteId], references: [id])
  companero         Usuario?    @relation("SolicitudCompanero", fields: [companeroId], references: [id])
  resueltaPor       Usuario?    @relation("SolicitudResolutor", fields: [resueltaPorId], references: [id])
  asignacionOrigen  Asignacion? @relation("SolicitudOrigen", fields: [asignacionOrigenId], references: [id])
  asignacionDestino Asignacion? @relation("SolicitudDestino", fields: [asignacionDestinoId], references: [id])

  @@index([estado, tipo])
  @@map("solicitud")
}

model PeriodoVacaciones {
  id              String   @id @default(uuid()) @db.Uuid
  usuarioId       String   @map("usuario_id") @db.Uuid
  causacionDesde  DateTime @map("causacion_desde") @db.Date
  causacionHasta  DateTime @map("causacion_hasta") @db.Date
  diasCausados    Decimal  @map("dias_causados") @db.Decimal(5, 2)
  diasDisfrutados Decimal  @default(0) @map("dias_disfrutados") @db.Decimal(5, 2)
  /// true si viene de la carga inicial (RF-VAC-06)
  cargaInicial    Boolean  @default(false) @map("carga_inicial")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("periodo_vacaciones")
}

// ---------------------------------------------------------------------------
// Pacientes atendidos (ADR-009). Los campos *_cifrado van cifrados con AES-256-GCM
// desde la API; la llave vive fuera de la base de datos.
// ---------------------------------------------------------------------------

model PacienteAtendido {
  id                 String        @id @default(uuid()) @db.Uuid
  usuarioId          String        @map("usuario_id") @db.Uuid
  asignacionId       String        @map("asignacion_id") @db.Uuid
  nombre             String
  tipoDocumento      TipoDocumento @map("tipo_documento")
  documentoCifrado   Bytes         @map("documento_cifrado")
  /// HMAC del documento para buscar sin descifrar
  documentoHash      String        @map("documento_hash")
  diagnosticoCie10   String?       @map("diagnostico_cie10")
  diagnosticoCifrado Bytes?        @map("diagnostico_cifrado")
  telefonoCifrado    Bytes?        @map("telefono_cifrado")
  estadoEgreso       EstadoEgreso  @map("estado_egreso")
  registradoEn       DateTime      @default(now()) @map("registrado_en") @db.Timestamptz

  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  asignacion Asignacion @relation(fields: [asignacionId], references: [id])

  @@index([asignacionId])
  @@index([documentoHash])
  @@map("paciente_atendido")
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

model Canal {
  id     String    @id @default(uuid()) @db.Uuid
  nombre String
  tipo   TipoCanal @default(GENERAL)

  mensajes Mensaje[]

  @@map("canal")
}

model Mensaje {
  id        String   @id @default(uuid()) @db.Uuid
  canalId   String   @map("canal_id") @db.Uuid
  autorId   String   @map("autor_id") @db.Uuid
  contenido String
  esNovedad Boolean  @default(false) @map("es_novedad")
  oculto    Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz

  canal Canal   @relation(fields: [canalId], references: [id])
  autor Usuario @relation(fields: [autorId], references: [id])

  @@index([canalId, creadoEn])
  @@map("mensaje")
}

// ---------------------------------------------------------------------------
// Configuración y auditoría
// ---------------------------------------------------------------------------

/// Parámetros laborales con vigencia (ADR-004). El cálculo usa el valor vigente en la fecha trabajada.
model Parametro {
  clave        String
  valor        String
  vigenteDesde DateTime  @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  @@id([clave, vigenteDesde])
  @@map("parametro")
}

model Festivo {
  fecha  DateTime @id @db.Date
  nombre String

  @@map("festivo")
}

/// Registro inmutable (RNF-06). Incluye lecturas de datos de pacientes (RNF-15).
model Auditoria {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  accion    String
  entidad   String
  entidadId String?  @map("entidad_id")
  antes     Json?
  despues   Json?
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz

  @@index([entidad, entidadId])
  @@index([creadoEn])
  @@map("auditoria")
}
