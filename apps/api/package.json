{
  "name": "@sgt/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de aplicación del SGT (NestJS). Persistencia en archivos JSON, sin base de datos",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@sgt/rules-engine": "*",
    "@sgt/shared-types": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
