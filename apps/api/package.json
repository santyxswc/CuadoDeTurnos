{
  "name": "@sgt/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de aplicación del SGT (NestJS + Prisma + PostgreSQL)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@prisma/client": "^7.10.0",
    "@sgt/rules-engine": "*",
    "@sgt/shared-types": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
